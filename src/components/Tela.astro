---
import type { ImageMetadata } from 'astro';

interface Props {
  tela: 'radar' | 'ordens' | 'estoque' | 'financeiro' | 'equipe';
  largura: 1440 | 390;
  alt: string;
  prioridade?: boolean;
  class?: string;
}
const { tela, largura, alt, prioridade = false, class: extra = '' } = Astro.props;

const imagens = import.meta.glob<{ default: ImageMetadata }>('../assets/telas/*.{avif,webp}', { eager: true });
const pegar = (ext: 'avif' | 'webp') => {
  const m = imagens[`../assets/telas/${tela}-${largura}.${ext}`];
  if (!m) throw new Error(`print ausente: ${tela}-${largura}.${ext}`);
  return m.default;
};
const avif = pegar('avif');
const webp = pegar('webp');
---

{
  largura === 1440 ? (
    <div
      data-moldura="janela"
      class:list={[
        'overflow-hidden rounded-2xl bg-sunken ring-1 ring-line-strong/60',
        'shadow-[0_30px_90px_-30px_rgb(var(--c-brand)/0.35)]',
        extra,
      ]}
    >
      <div class="flex h-8 items-center gap-1.5 bg-muted px-3" aria-hidden="true">
        <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
        <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
        <span class="h-2.5 w-2.5 rounded-full bg-line-strong" />
      </div>
      <picture>
        <source type="image/avif" srcset={avif.src} />
        <img
          src={webp.src}
          alt={alt}
          width={webp.width}
          height={webp.height}
          loading={prioridade ? 'eager' : 'lazy'}
          decoding="async"
          class="block h-auto w-full"
        />
      </picture>
    </div>
  ) : (
    <div
      data-moldura="celular"
      class:list={[
        'relative rounded-[2rem] bg-muted p-2 ring-1 ring-line-strong/70',
        'shadow-[0_24px_70px_-24px_rgb(var(--c-brand)/0.4)]',
        extra,
      ]}
    >
      <span
        class="absolute left-1/2 top-3 z-10 h-1.5 w-12 -translate-x-1/2 rounded-full bg-sunken"
        aria-hidden="true"
      />
      <div class="overflow-hidden rounded-[1.5rem]">
        <picture>
          <source type="image/avif" srcset={avif.src} />
          <img
            src={webp.src}
            alt={alt}
            width={webp.width}
            height={webp.height}
            loading={prioridade ? 'eager' : 'lazy'}
            decoding="async"
            class="block h-auto w-full"
          />
        </picture>
      </div>
    </div>
  )
}
