---
import { site } from '../site.config';
import Botao from './Botao.astro';

const links = [
  { href: '/#recursos', rotulo: 'Recursos' },
  { href: '/#telas', rotulo: 'Telas' },
  { href: '/#planos', rotulo: 'Planos' },
  { href: '/#duvidas', rotulo: 'Dúvidas' },
];
---

<header class="fixed inset-x-0 top-0 z-40 bg-canvas/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-2 px-4">
    <a href="/" class="mr-auto flex min-h-11 items-center gap-2" aria-label="Mecanify, página inicial">
      <img src="/logo.svg" alt="" width="32" height="32" />
      <span class="hidden text-base font-semibold sm:inline">Mecanify</span>
    </a>

    <nav aria-label="Principal" class="hidden items-center md:flex">
      {
        links.map((l) => (
          <a href={l.href} class="flex min-h-11 items-center rounded-lg px-3 text-sm text-ink-muted hover:text-ink">
            {l.rotulo}
          </a>
        ))
      }
    </nav>

    <details class="md:hidden">
      <summary
        class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-lg text-sm text-ink-muted hover:text-ink"
        aria-label="Menu"
      >
        Menu
      </summary>
      <nav aria-label="Menu" class="absolute right-4 top-14 w-48 rounded-2xl bg-surface p-2">
        {
          links.map((l) => (
            <a href={l.href} class="flex min-h-11 items-center rounded-lg px-3 text-sm hover:bg-muted">
              {l.rotulo}
            </a>
          ))
        }
      </nav>
    </details>

    <a
      href={site.urls.app}
      data-cta="entrar"
      class="flex min-h-11 items-center rounded-lg px-3 text-sm text-ink hover:bg-muted">Entrar</a
    >
    <Botao cadastro origem="header" class="px-3 sm:px-5">Testar 30 dias grátis</Botao>
  </div>
</header>
