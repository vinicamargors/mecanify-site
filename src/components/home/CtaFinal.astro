---
import Botao from '../Botao.astro';
import SeloTeste from '../SeloTeste.astro';
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <div class="space-y-6 rounded-2xl bg-surface p-8 text-center md:p-14">
    <h2 class="text-3xl font-semibold md:text-4xl">Seu pátio organizado ainda esta semana.</h2>
    <div class="flex justify-center">
      <Botao cadastro origem="cta-final" class="h-12 px-6 text-base">Testar 30 dias grátis</Botao>
    </div>
    <SeloTeste />
  </div>
</section>
