---
import Botao from '../Botao.astro';
import SeloTeste from '../SeloTeste.astro';
import sequencias from '../../lib/sequencia.json';

const { desktop, celular } = sequencias;
const poster = (base: string) => `${base}/000.webp`;
---

<section data-hero-palco class="relative">
  <div data-hero-fixo class="relative overflow-clip">
    <canvas id="hero-fundo" aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full"></canvas>
    <!-- Véu sobre o fundo animado onde fica o texto: mantém o título legível. -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-canvas via-canvas/80 to-transparent lg:bg-gradient-to-r lg:via-canvas/70"
    >
    </div>
    <div class="relative mx-auto grid w-full max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-2 lg:py-24">
      <div class="space-y-6">
        <h1 class="text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
          Sistema para oficina mecânica que cabe no ritmo do pátio
        </h1>
        <p class="max-w-xl text-lg text-ink-muted">
          Ordens de serviço, pátio, estoque, caixa e equipe em um só lugar. No computador do balcão ou no celular, com
          a mão suja de graxa.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <Botao cadastro origem="hero" class="h-12 px-6 text-base">Testar 30 dias grátis</Botao>
          <Botao href="#telas" variante="secundario" class="h-12 px-6 text-base">Ver o sistema</Botao>
        </div>
        <SeloTeste />
      </div>

      <!-- Abaixo de 1024px só o visual fica preso (o texto não caberia numa tela presa). -->
      <div data-palco-visual class="relative">
        <div data-fixo-visual class="relative mx-auto aspect-[4/5] w-full max-w-md md:aspect-[6/5] md:max-w-none">
          <picture id="hero-poster" class="block h-full w-full">
            <source media="(max-width: 767px)" type="image/webp" srcset={poster(celular.base)} />
            <img
              src={poster(desktop.base)}
              alt="Notebook e celular com o Radar do Pátio do Mecanify aberto: ordens de serviço divididas por etapa"
              width={desktop.largura}
              height={desktop.altura}
              fetchpriority="high"
              class="h-full w-full object-contain"
            />
          </picture>
          <canvas
            id="hero-seq"
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 h-full w-full"
            data-base-desktop={desktop.base}
            data-total-desktop={desktop.total}
            data-base-celular={celular.base}
            data-total-celular={celular.total}></canvas>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { montarSequencia } from './SequenciaHero';
  import { montarFundo } from './FundoAneis';

  const palcoHero = document.querySelector<HTMLElement>('[data-hero-palco]');
  const fixoHero = document.querySelector<HTMLElement>('[data-hero-fixo]');
  const palcoVisual = document.querySelector<HTMLElement>('[data-palco-visual]');
  const fixoVisual = document.querySelector<HTMLElement>('[data-fixo-visual]');
  const animado = document.documentElement.hasAttribute('data-hero-animado');
  const limitar = (v: number) => Math.min(Math.max(v, 0), 1);

  /** Progresso do trecho preso: o hero inteiro no desktop, só o visual abaixo de 1024px. */
  function progressoSequencia(): number {
    const desktop = matchMedia('(min-width: 1024px)').matches;
    const palco = desktop ? palcoHero : palcoVisual;
    const fixo = desktop ? fixoHero : fixoVisual;
    if (!palco || !fixo) return 0;
    const topo = parseFloat(getComputedStyle(fixo).top) || 0;
    const curso = Math.max(1, palco.offsetHeight - fixo.offsetHeight);
    return limitar((topo - palco.getBoundingClientRect().top) / curso);
  }

  // --- Sequência de quadros ---
  const canvasSeq = document.getElementById('hero-seq') as HTMLCanvasElement | null;
  const poster = document.getElementById('hero-poster');
  if (canvasSeq) {
    const celular = matchMedia('(max-width: 767px)').matches;
    const d = canvasSeq.dataset;
    try {
      montarSequencia(canvasSeq, {
        base: (celular ? d.baseCelular : d.baseDesktop)!,
        total: Number(celular ? d.totalCelular : d.totalDesktop),
        progresso: progressoSequencia,
        estatico: !animado,
        aoPrimeiroQuadro: () => poster?.setAttribute('data-oculto', ''),
      });
    } catch {
      // Sem canvas 2D: o pôster continua visível.
    }
  }

  // --- Fundo animado: monta depois do carregamento para não competir com o conteúdo principal ---
  const canvasFundo = document.getElementById('hero-fundo') as HTMLCanvasElement | null;

  function progressoHero(): number {
    if (!palcoHero || !fixoHero) return 0;
    const curso = Math.max(palcoHero.offsetHeight - fixoHero.offsetHeight, palcoHero.offsetHeight * 0.6, 1);
    return limitar(-palcoHero.getBoundingClientRect().top / curso);
  }

  function iniciarFundo(): void {
    if (!canvasFundo) return;
    const celular = matchMedia('(max-width: 767px)').matches;
    try {
      montarFundo(canvasFundo, {
        cores: ['#F5B544', '#D98A0B', '#5A3A08'],
        densidade: celular ? 220 : 300,
        dprMax: celular ? 1.5 : 2,
        progresso: progressoHero,
        estatico: !animado,
      });
      canvasFundo.dataset.ativo = '';
      if (!animado) canvasFundo.dataset.estatico = '';
    } catch {
      // Sem WebGL: fica o fundo liso da página.
    }
  }

  if (document.readyState === 'complete') iniciarFundo();
  else window.addEventListener('load', iniciarFundo, { once: true });
</script>
