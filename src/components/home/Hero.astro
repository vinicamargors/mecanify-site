---
import Botao from '../Botao.astro';
import SeloTeste from '../SeloTeste.astro';
import texturaDesktop from '../../assets/telas/radar-1440.webp';
import texturaMobile from '../../assets/telas/radar-390.webp';
---

<section data-hero-palco class="relative">
  <div data-hero-fixo class="relative overflow-hidden">
  <canvas id="hero-fundo" aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full"></canvas>
  <!-- Véu sobre o fundo animado onde fica o texto: mantém o título legível. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-canvas via-canvas/80 to-transparent lg:bg-gradient-to-r lg:via-canvas/70"
  >
  </div>
  <div class="relative mx-auto grid w-full max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-2 lg:py-24">
    <div class="space-y-6">
      <h1 class="text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
        Sistema para oficina mecânica que cabe no ritmo do pátio
      </h1>
      <p class="max-w-xl text-lg text-ink-muted">
        Ordens de serviço, pátio, estoque, caixa e equipe em um só lugar. No computador do balcão ou no celular, com
        a mão suja de graxa.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <Botao cadastro origem="hero" class="h-12 px-6 text-base">Testar 30 dias grátis</Botao>
        <Botao href="#telas" variante="secundario" class="h-12 px-6 text-base">Ver o sistema</Botao>
      </div>
      <SeloTeste />
    </div>

    <div class="relative mx-auto aspect-[5/6] w-full max-w-md md:aspect-[6/5] md:max-w-none">
      <picture id="hero-fallback" class="block">
        <source media="(max-width: 767px)" type="image/avif" srcset="/hero/fallback-mobile.avif" />
        <source media="(max-width: 767px)" type="image/webp" srcset="/hero/fallback-mobile.webp" />
        <source type="image/avif" srcset="/hero/fallback.avif" />
        <img
          src="/hero/fallback.webp"
          alt="Radar do Pátio do Mecanify aberto no computador, com as ordens de serviço divididas por etapa"
          width="1200"
          height="1000"
          fetchpriority="high"
          class="h-full w-full rounded-2xl object-contain"
        />
      </picture>
      <div
        id="hero-3d"
        aria-hidden="true"
        class="absolute inset-0"
        data-tex-desktop={texturaDesktop.src}
        data-tex-mobile={texturaMobile.src}
      >
      </div>
    </div>
  </div>
  </div>
</section>

<script>
  import { montarFundo } from './FundoAneis';

  // Fundo animado: monta depois do carregamento para não competir com o conteúdo principal.
  const canvasFundo = document.getElementById('hero-fundo') as HTMLCanvasElement | null;
  const palcoFundo = document.querySelector<HTMLElement>('[data-hero-palco]');
  const fixoFundo = document.querySelector<HTMLElement>('[data-hero-fixo]');

  function progressoHero(): number {
    if (!palcoFundo || !fixoFundo) return 0;
    const curso = Math.max(palcoFundo.offsetHeight - fixoFundo.offsetHeight, palcoFundo.offsetHeight * 0.6, 1);
    return Math.min(Math.max(-palcoFundo.getBoundingClientRect().top / curso, 0), 1);
  }

  function iniciarFundo(): void {
    if (!canvasFundo) return;
    const reduzMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Sem a liberação do 3D (aparelho fraco), o fundo vira um quadro parado.
    const estatico = reduzMovimento || !document.documentElement.hasAttribute('data-hero3d');
    const celular = matchMedia('(max-width: 767px)').matches;
    try {
      montarFundo(canvasFundo, {
        cores: ['#F5B544', '#D98A0B', '#5A3A08'],
        densidade: celular ? 220 : 300,
        dprMax: celular ? 1.5 : 2,
        progresso: progressoHero,
        estatico,
      });
      canvasFundo.dataset.ativo = '';
      if (estatico) canvasFundo.dataset.estatico = '';
    } catch {
      // Sem WebGL: fica o fundo liso da página.
    }
  }

  if (document.readyState === 'complete') iniciarFundo();
  else window.addEventListener('load', iniciarFundo, { once: true });
</script>

<script>
  const alvo = document.getElementById('hero-3d');
  const fallback = document.getElementById('hero-fallback');

  if (alvo && fallback) {
    const forcado = new URLSearchParams(location.search).has('render-fallback');
    // A decisão (WebGL, núcleos, memória, reduzir movimento) é tomada no <head>, em Base.astro.
    const usar = forcado || document.documentElement.hasAttribute('data-hero3d');

    if (usar) {
      const observador = new IntersectionObserver(async (entradas) => {
        if (!entradas.some((e) => e.isIntersecting)) return;
        observador.disconnect();
        try {
          const { montarHero } = await import('./Hero3D');
          montarHero(
            alvo,
            { desktop: alvo.dataset.texDesktop!, mobile: alvo.dataset.texMobile! },
            {
              estatico: forcado,
              aoPrimeiroQuadro: () => fallback.setAttribute('data-oculto', ''),
              aoFalhar: () => fallback.removeAttribute('data-oculto'),
            },
          );
        } catch {
          fallback.removeAttribute('data-oculto');
        }
      });
      observador.observe(alvo);
    }
  }
</script>
