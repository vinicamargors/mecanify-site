---
import { site } from '../site.config';

interface Props {
  href?: string;
  variante?: 'primario' | 'secundario' | 'fantasma';
  /** Liga ao cadastro: href inicial + data-cta, reescrito com utm_* no cliente. */
  cadastro?: boolean;
  origem?: string;
  class?: string;
}
const { href, variante = 'primario', cadastro = false, origem, class: extra = '' } = Astro.props;
const destino = cadastro ? site.urls.cadastro : href;
const base =
  'inline-flex min-h-11 items-center justify-center rounded-lg px-5 text-sm font-medium transition-colors';
const estilos = {
  primario: 'bg-brand text-on-brand hover:bg-brand-hover',
  secundario: 'bg-muted text-ink hover:bg-line',
  fantasma: 'text-ink hover:bg-muted',
};
---

<a
  href={destino}
  class={`${base} ${estilos[variante]} ${extra}`}
  data-cta={cadastro ? 'cadastro' : undefined}
  data-cta-origem={origem}
>
  <slot />
</a>
