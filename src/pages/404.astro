---
import Base from '../layouts/Base.astro';
import Botao from '../components/Botao.astro';
---

<Base titulo="Página não encontrada | Mecanify" descricao="Essa página não existe. Volte para a página inicial do Mecanify." caminho="/404">
  <section class="mx-auto max-w-6xl px-4 py-24">
    <h1 class="text-4xl font-semibold">Página não encontrada</h1>
    <p class="mt-4 text-ink-muted">O endereço que você abriu não existe.</p>
    <Botao href="/" class="mt-8">Voltar para o início</Botao>
  </section>
</Base>
