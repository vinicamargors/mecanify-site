---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import AvisoRascunho from '../components/AvisoRascunho.astro';
import { precisaAviso } from '../lib/legal';

export async function getStaticPaths() {
  const paginas = await getCollection('legal');
  return paginas.map((p) => ({ params: { slug: p.id }, props: { pagina: p } }));
}

const { pagina } = Astro.props;
const { Content } = await render(pagina);
const { titulo, descricao, atualizadoEm, revisado } = pagina.data;
const data = atualizadoEm.toLocaleDateString('pt-BR', { timeZone: 'UTC' });
---

<Base titulo={`${titulo} | Mecanify`} descricao={descricao} caminho={`/${pagina.id}`}>
  <article class="mx-auto max-w-3xl px-4 py-16">
    {precisaAviso(revisado) && <AvisoRascunho />}
    <h1 class="text-4xl font-semibold">{titulo}</h1>
    <p class="mt-2 text-sm text-ink-subtle">Atualizado em {data}</p>
    <div class="legal mt-8 space-y-4 text-ink-muted">
      <Content />
    </div>
  </article>
</Base>

<style is:global>
  .legal h2 {
    margin-top: 2rem;
    font-size: 1.5rem;
    font-weight: 600;
    color: rgb(var(--c-ink));
  }
  .legal ul {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .legal a {
    color: rgb(var(--c-brand-ink));
    text-decoration: underline;
  }
  .legal table {
    width: 100%;
    font-size: 0.875rem;
    border-collapse: collapse;
  }
  .legal th,
  .legal td {
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
    background: rgb(var(--c-surface));
  }
  .legal tr + tr td {
    border-top: 1px solid rgb(var(--c-line));
  }
</style>
